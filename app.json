{
  "expo": {
    "name": "LetsLiinger",
    "slug": "LetsLiinger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "letsliinger",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.letsliinger.LetsLiinger",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LetsLiinger uses your location to show events happening near you and to place event pins on the campus map. You can decline and still use the app.",
        "NSPhotoLibraryUsageDescription": "LetsLiinger needs access to your photos so you can set a profile picture and add a cover image to your events.",
        "NSCameraUsageDescription": "LetsLiinger uses your camera so you can take a new profile picture or event photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "package": "com.letsliinger.LetsLiinger",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LetsLiinger uses your location to show events happening near you and to place event pins on the campus map. You can decline and still use the app."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4ab3b37-e91d-4147-92f9-ca8b892d9b0e"
      }
    },
    "owner": "albertwongs-team"
  }
}

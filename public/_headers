# Cloudflare Pages cache rules for the Expo web build (lets-liinger.pages.dev).
# `npx expo export -p web` copies this file into dist/, and Pages reads it.

# Pages (HTML) are always re-checked, so a new deploy shows up on the next
# refresh instead of people seeing an old cached version of the app.
/*
  Cache-Control: no-cache

# JS/CSS bundles and fonts have a content hash in their file name, so they can
# be cached for a year. A new deploy gets new file names automatically.
# "! Cache-Control" drops the no-cache rule above for these paths.
/_expo/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
